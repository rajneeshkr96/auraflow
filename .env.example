# ─── Instagram OAuth Configuration ───────────────────────────────────────────
# Choose ONE of the two flows below based on your Meta app setup:

# Option 1: "API setup with Instagram login" (recommended for Instagram-only apps)
# Get these from: developers.facebook.com → Your App → Instagram → API Setup with Instagram login
INSTAGRAM_APP_CLIENT_ID=1554670022487482
INSTAGRAM_APP_CLIENT_SECRET=your_instagram_app_secret_here

# Option 2: "API setup with Facebook login" (for apps that need Facebook Pages)
# Get these from: developers.facebook.com → Your App → Settings → Basic
# INSTAGRAM_CLIENT_ID=926178093431184
# INSTAGRAM_CLIENT_SECRET=your_facebook_app_secret_here

# Common settings (required for both flows)
INSTAGRAM_REDIRECT_URI=https://aura.codeswayam.com/api/integrations/instagram/callback
NEXT_PUBLIC_APP_URL=https://aura.codeswayam.com

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/auraflow

# ─── Neural API (for AI Agents) ───────────────────────────────────────────────
NEURAL_API_KEY=your_neural_api_key
NEURAL_API_URL=http://localhost:3006

# ─── Google AI (for Gemini) ───────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ─── Auth Service ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_AUTH_URL=http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Analytics (optional) ─────────────────────────────────────────────────────
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
