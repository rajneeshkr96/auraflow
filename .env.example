# ─── Core Platform & Auth ───────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_AUTH_URL="http://localhost:3003"
NEXT_PUBLIC_APP_URL="http://localhost:3006"
JWT_SECRET="your_jwt_secret_here"

# ─── MongoDB (Auraflow Database) ──────────────────────────────────
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/auraflow?retryWrites=true&w=majority
MONGODB_URL="mongodb://localhost:27017/auraflow"

# ─── Instagram Business API & Webhooks ─────────────────────────────
# Get credentials from: Meta for Developers → App → Instagram Business Login
INSTAGRAM_APP_CLIENT_ID="your_instagram_app_id"
INSTAGRAM_APP_CLIENT_SECRET="your_instagram_app_secret"
INSTAGRAM_REDIRECT_URI="https://aura.codeswayam.com/api/integrations/instagram/callback"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN="your_webhook_verify_token"

# ─── NeuralHub AI Platform ─────────────────────────────────────────
# Get your platform API key from NeuralHub (neural-web) → API Keys
NEURAL_API_KEY="nhub_live_your_platform_api_key_here"
NEXT_PUBLIC_NEURAL_WEB_URL="http://localhost:3004"
