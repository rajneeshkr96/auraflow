generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model Automation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @default("Untitled")
  active    Boolean  @default(false)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggers  Trigger[]
  keywords  Keyword[]
  listener  Listener?
  posts     Post[]

  @@map("automations")
}

model Trigger {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  type         TriggerType
  automationId String     @db.ObjectId
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("triggers")
}

model Keyword {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  word         String
  automationId String     @db.ObjectId
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("keywords")
}

model Listener {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  listener       ListenerType @default(MESSAGE)
  commentReply   String?
  dmReply        String?
  prompt         String?
  // Neural agent ID created per-user when they first use SMART_AI
  neuralAgentId  String?
  // Neural KB ID (from neural-web) attached to this agent for RAG
  neuralKbId     Int?
  automationId   String       @unique @db.ObjectId
  automation     Automation   @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("listeners")
}

model Post {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  postid       String
  caption      String?
  media        String?
  mediaType    String?
  automationId String     @db.ObjectId
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("posts")
}

model Integration {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  name        IntegrationType @default(INSTAGRAM)
  token       String
  instagramId String?         @unique
  pageId      String?
  expiresAt   DateTime?
  userId      Int
  createdAt   DateTime        @default(now())

  conversations Conversation[]

  @@map("integrations")
}

model Conversation {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  recipientId   String
  userId        Int
  createdAt     DateTime    @default(now())
  integrationId String?     @db.ObjectId
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  messages Message[]

  @@unique([userId, recipientId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  role           MessageRole
  content        String
  mid            String?      // Instagram message ID — used for deduplication
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime     @default(now())
  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum TriggerType {
  DM
  COMMENT
}

enum ListenerType {
  MESSAGE
  SMART_AI
}

enum IntegrationType {
  INSTAGRAM
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ── Webhook Deduplication ────────────────────────────────────────────────────
// Stores processed Instagram comment IDs to prevent re-processing on retries
model ProcessedComment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  commentId String   @unique
  createdAt DateTime @default(now())

  @@map("processed_comments")
}

// ── Usage Tracking & Limits ──────────────────────────────────────────────────
model SubscriptionUsage {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            Int      @unique
  automationsUsed   Int      @default(0)
  dmsThisMonth      Int      @default(0)
  commentsThisMonth Int      @default(0)
  triggersThisMonth Int      @default(0)
  resetDate         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("subscription_usage")
}

// ── Template System ──────────────────────────────────────────────────────────
model Template {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  category    TemplateCategory
  tier        TemplateTier
  config      Json         // automation configuration
  tags        String[]
  featured    Boolean      @default(false)
  usageCount  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("templates")
}

// ── Team Management ──────────────────────────────────────────────────────────
model Team {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  ownerId   Int
  plan      String       @default("enterprise")
  members   TeamMember[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("teams")
}

model TeamMember {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  teamId String   @db.ObjectId
  userId Int
  role   TeamRole
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ── Analytics & Metrics ──────────────────────────────────────────────────────
model AnalyticsEvent {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  userId       Int
  eventType    EventType
  automationId String?     @db.ObjectId
  metadata     Json?
  timestamp    DateTime    @default(now())

  @@map("analytics_events")
}

model DailyStats {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        Int
  date          DateTime
  triggers      Int      @default(0)
  dmsSent       Int      @default(0)
  commentsSent  Int      @default(0)
  conversions   Int      @default(0)

  @@unique([userId, date])
  @@map("daily_stats")
}

// ── AI Agent Management ──────────────────────────────────────────────────────
model AIAgent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       Int
  name         String
  personality  String
  instructions String
  neuralId     String?  // Neural API agent ID
  kbId         Int?     // Knowledge base ID
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_agents")
}

// ── Enums ────────────────────────────────────────────────────────────────────
enum TemplateCategory {
  LEAD_GENERATION
  CUSTOMER_SUPPORT
  ENGAGEMENT
  SALES
  CONTENT_PROMOTION
}

enum TemplateTier {
  FREE
  STANDARD
  PRO
  ENTERPRISE
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum EventType {
  AUTOMATION_TRIGGERED
  DM_SENT
  COMMENT_REPLIED
  CONVERSION
  LOGIN
  TEMPLATE_USED
}
